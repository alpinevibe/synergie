# Données produites (projets, boîte à trames, générations) : jamais versionnées.
donnees/projets/
donnees/boite/
donnees/generations/
donnees/*.log
__pycache__/
*.pyc

# Base de l'atelier : donnée de travail, jamais versionnée (SQLite crée aussi des fichiers
# temporaires -wal et -shm, et le fichier d'avant la bascule est conservé à part).
donnees/*.db
donnees/*.db-shm
donnees/*.db-wal
donnees/*.avant-postgres
donnees/*.avant-postgres-shm
donnees/*.avant-postgres-wal
donnees/documents/
